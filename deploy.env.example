# Kopiere diese Datei nach "deploy.env" und trage deine Werte ein.
# deploy.env landet NICHT im Git - sie enthaelt Klartext-Zugangsdaten.
#
# Sonderzeichen im Passwort sind in Ordnung - das Skript reicht Benutzer und
# Passwort als eigene Angaben an WinSCP weiter, nicht als Teil einer Adresse.
# Einzige Ausnahme: ein doppeltes Anfuehrungszeichen (") im Passwort geht nicht.

# Pfad zur portablen WinSCP-Konsole (nicht WinSCP.exe, sondern WinSCP.com).
WINSCP_PATH=C:\Tools\WinSCP\WinSCP.com

# sftp oder ftp. Bietet dein Strato-Paket kein SFTP: hier ftp eintragen, dann
# wird SFTP_HOSTKEY nicht gebraucht und darf leer bleiben.
SFTP_PROTOCOL=sftp
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=

# Nur bei sftp noetig. Format ohne "SHA256:"-Praefix, genau so wie WinSCP es meldet:
#   ssh-ed25519 255 1gx2w8Rtv3wCgi7Jh8myf...
# So kommst du dran: WinSCP von Hand verbinden, dann Strg+I und den Fingerabdruck
# kopieren. Kein Stern als Platzhalter - der wuerde jeden Server akzeptieren.
SFTP_HOSTKEY=

# Eigener Ordner der Subdomain auf dem Server, mit Schraegstrich am Ende,
# z. B. /scanner/ - NIE "/". Der Upload loescht im Ziel alles, was nicht zur
# App gehoert.
REMOTE_WEB_PATH=/scanner/

# Standard "/". Nur aendern, wenn die App in einem Unterordner einer Domain
# laeuft, dann z. B. /scanner/.
BASE_HREF=/

# Nur fuer die Abschlussmeldung, z. B. https://scan.example.de/
PUBLIC_URL=
